# Secret-free configuration template — never commit a populated copy.
# Required secrets are injected through the approved staging secret manager only.

BANKTO_CORE_IMAGE=bankto-core@sha256:REPLACE_WITH_APPROVED_DIGEST
BANKTO_API_IMAGE=bankto-api@sha256:REPLACE_WITH_APPROVED_DIGEST
BANKTO_AUTH_EGRESS_NETWORK=bankto-auth0-development-egress

API_POSTGRES_DB=bankto_api_staging_synthetic
CORE_POSTGRES_DB=bankto_core_staging_synthetic
API_POSTGRES_USER=REPLACE_FROM_SECRET_MANAGER
API_POSTGRES_PASSWORD=REPLACE_FROM_SECRET_MANAGER
CORE_POSTGRES_USER=REPLACE_FROM_SECRET_MANAGER
CORE_POSTGRES_PASSWORD=REPLACE_FROM_SECRET_MANAGER
API_DATABASE_URL=REPLACE_FROM_SECRET_MANAGER
CORE_DATABASE_URL=REPLACE_FROM_SECRET_MANAGER
CORE_SERVICE_KEY=REPLACE_FROM_SECRET_MANAGER

# Auth0 Development tenant only; no production audience, client credential, or token value.
AUTH0_DOMAIN=REPLACE_FROM_SECRET_MANAGER
AUTH0_AUDIENCE=REPLACE_FROM_SECRET_MANAGER
